# Shared LLM configuration for Phase 05 and Phase 06.
IOP_LLM_PROVIDER=huggingface
IOP_LLM_MODEL=Qwen/Qwen3-8B
# Maximum tokens generated by each Phase 05/06 LLM request.
IOP_LLM_MAX_NEW_TOKENS=512
# Use 4-bit quantization when CUDA is available (recommended for an 8 GB GPU).
IOP_LLM_LOAD_IN_4BIT=true
# Not needed for the direct Hugging Face provider. Base URL is used by Ollama,
# another OpenAI-compatible endpoint, or an optional Anthropic-compatible gateway.
# IOP_LLM_BASE_URL=http://localhost:11434/v1
# IOP_LLM_API_KEY=
# Provider-specific API keys (IOP_LLM_API_KEY takes precedence when set).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Phase 04 semantic embeddings. When configured, the FastAPI web
# pipeline creates vectors and Phase 05 uses hybrid retrieval automatically.
# PHASE04_EMBEDDING_PROVIDER=sentence_transformers
# PHASE04_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# PHASE04_EMBEDDING_DIMENSIONS=384
