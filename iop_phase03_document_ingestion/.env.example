# Shared LLM configuration for Phase 05 and Phase 06.
IOP_LLM_PROVIDER=huggingface
IOP_LLM_MODEL=Qwen/Qwen3-8B
# Maximum tokens generated by each Phase 05/06 LLM request.
IOP_LLM_MAX_NEW_TOKENS=2048
# Use 4-bit quantization when CUDA is available (recommended for an 8 GB GPU).
IOP_LLM_LOAD_IN_4BIT=true
# Not needed for the direct Hugging Face provider. These are only for Ollama
# or another OpenAI-compatible endpoint.
# IOP_LLM_BASE_URL=http://localhost:11434/v1
# IOP_LLM_API_KEY=
