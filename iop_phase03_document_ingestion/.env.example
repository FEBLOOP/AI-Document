# Shared LLM configuration for Phase 05 and Phase 06.
IOP_LLM_PROVIDER=huggingface
IOP_LLM_MODEL=Qwen/Qwen3-8B
# Maximum tokens generated by each Phase 05/06 LLM request.
IOP_LLM_MAX_NEW_TOKENS=8192
# Use 4-bit quantization when CUDA is available (recommended for an 8 GB GPU).
IOP_LLM_LOAD_IN_4BIT=true
# Not needed for the direct Hugging Face provider. Base URL is used by Ollama,
# another OpenAI-compatible endpoint, or an optional Anthropic-compatible gateway.
# IOP_LLM_BASE_URL=http://localhost:11434/v1
# IOP_LLM_API_KEY=
# Provider-specific API keys (IOP_LLM_API_KEY takes precedence when set).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Phase 04 semantic embeddings. Web Hybrid Retrieval defaults to the
# sentence-transformers provider below when PHASE04_EMBEDDING_PROVIDER is not
# set. Setting it explicitly to none requires IOP_WEB_RETRIEVAL_MODE=lexical.
# PHASE04_EMBEDDING_PROVIDER=sentence_transformers
# PHASE04_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# PHASE04_EMBEDDING_DIMENSIONS=384

# Web Phase 05 defaults. CLI defaults remain unchanged.
IOP_WEB_RETRIEVAL_MODE=hybrid
IOP_WEB_RETRIEVAL_FALLBACK=error
IOP_WEB_TOP_K=5
IOP_WEB_SEMANTIC_WEIGHT=0.7
IOP_WEB_LLM_BATCH_SIZE=1
IOP_WEB_MAX_EVIDENCE_CHARS=1200
# Restart Phase 05 once and resume its validated checkpoint after a failure.
IOP_WEB_PHASE05_RESTARTS=1

# Optional Phase 07 score presentation/classification settings. The official
# IOP rounding convention should be confirmed before changing these defaults.
IOP_SCORE_DISPLAY_DECIMALS=2
IOP_SCORE_CLASSIFICATION_DECIMALS=1
IOP_SCORE_ROUNDING=half_up

# Internal File Manager. Generated outputs default to data/output and source
# PDFs default to data/input/uploads. DELETE APIs remain disabled until a
# strong shared token is configured. Use HTTPS when entering/sending this token.
# IOP_FILE_MANAGER_ACCESS_TOKEN=replace-with-a-long-random-secret
# IOP_FILE_MANAGER_ID_SECRET=replace-with-a-separate-stable-random-secret
# Optional additional/alternative generated-output roots, separated by the OS
# path separator (semicolon on Windows, colon on Linux).
# IOP_FILE_MANAGER_OUTPUT_ROOTS=C:\absolute\managed\output

# Multi-PDF upload limits (bytes). Each combined submission becomes one
# Assessment ID. Defaults: 10 files, 50 MiB/file, 200 MiB total, and at least
# 100 MiB free storage before accepting the upload.
IOP_MULTI_MAX_FILES=10
IOP_MULTI_MAX_FILE_BYTES=52428800
IOP_MULTI_MAX_TOTAL_BYTES=209715200
IOP_MULTI_MIN_FREE_BYTES=104857600
